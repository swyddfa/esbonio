{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "paths": {
      "src/*": [
        "./src/*"
      ],
      "vscode": [
        "./node_modules/@types/vscode"
      ]
    },
    "types": ["mocha"],
    "lib": [
      "ES2020"
    ],
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedParameters": true
  },
  "exclude": [
    "node_modules/",
  ]
}
