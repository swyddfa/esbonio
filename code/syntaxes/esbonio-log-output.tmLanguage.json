{
    "scopeName": "source.esbonio-log-output",
    "patterns": [
        {
            "include": "#log-line"
        },
        {
            "include": "#json"
        },
        {
            "include": "#string"
        }
    ],
    "repository": {
        "log-line": {
            "match": "^(\\[([./$a-zA-Z]+)\\(([\\d]+)?\\)\\])?\\[([.a-zA-Z]+)\\]",
            "captures": {
                "2": {
                    "name": "keyword.control"
                },
                "3": {
                    "name": "constant.numeric"
                },
                "4": {
                    "name": "entity.name.class"
                }
            }
        },
        "string": {
            "match": "('|\").*?('|\")",
            "name": "string"
        },
        "json": {
            "begin": "(?={$)",
            "end": "(?<=^})",
            "name": "source.json",
            "patterns": [
                {
                    "include": "source.json"
                }
            ]
        }
    }
}
